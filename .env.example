# Application
APP_NAME=AegisFlow
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Database
POSTGRES_DB=aegisflow
POSTGRES_USER=aegisflow_user
POSTGRES_PASSWORD=change_this_dev_password
DATABASE_URL=postgresql+psycopg://aegisflow_user:change_this_dev_password@localhost:5432/aegisflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
